# Copia este archivo como .env y completa los valores reales.
# El .env real NO se commitea (está en .gitignore).

# --- Conexión a la base de datos ---
# Opción recomendada: cadena completa (pooler de Supabase).
DATABASE_URL=postgresql://usuario:password@host:puerto/postgres

# Esquema donde viven las tablas del sistema de matrículas.
DB_SCHEMA=matriculas

# --- Alternativa: variables sueltas (si no usas DATABASE_URL) ---
# DB_NAME=postgres
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432

# --- Autenticación Google Workspace (Fase 4) ---
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_HOSTED_DOMAIN=slepvalparaiso.cl

# --- JWT ---
# JWT_SECRET_KEY=cambia-esta-clave-en-produccion
# ACCESS_TOKEN_EXPIRE_MINUTES=120

# --- CORS (producción) ---
# Lista separada por comas de orígenes permitidos. Vacío = permitir todo (solo dev).
# CORS_ORIGINS=https://matricula.slepvalparaiso.gob.cl
