# Copia como .env.production y completa los valores para el build de producción.
# Vite inyecta estas variables en tiempo de build (npm run build).

# URL pública del backend en producción
VITE_API_URL=https://api.matricula.slepvalparaiso.gob.cl

# Client ID de Google (el mismo que GOOGLE_CLIENT_ID del backend)
VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
